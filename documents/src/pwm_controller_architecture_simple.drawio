        <!-- SUBMODULE 1: pwm_registers -->
        <mxCell id="mod_regs" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;pwm_registers&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; font-weight: normal; color: #1E40AF;&quot;&gt;Bus Interface &amp;amp; Configuration Storage&lt;/font&gt;&lt;hr style=&quot;margin: 6px 0; border: none; border-top: 1px solid #BFDBFE;&quot;&gt;&lt;div style=&quot;text-align: left; padding-left: 20px; font-size: 11.5px; font-weight: normal; color: #0F172A; line-height: 1.5;&quot;&gt;• &lt;b&gt;DUTY_CH0..7 Registers [7:0]&lt;/b&gt; — Duty cycle thresholds for channels 0 to 7 (Addr 0x0 – 0x7)&lt;br&gt;• &lt;b&gt;CH_EN Register [7:0]&lt;/b&gt; — Individual channel enables &lt;i&gt;ch_en[0..7]&lt;/i&gt; (Addr 0x8)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=center;verticalAlign=top;spacingTop=10;fontSize=14;fontColor=#1E3A8A;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="200" y="88" width="600" height="105" as="geometry" />
