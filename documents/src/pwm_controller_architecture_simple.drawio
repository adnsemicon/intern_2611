        <!-- SUBMODULE 3: pwm_channel [0..7] Instances -->
        <mxCell id="mod_chan" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;pwm_channel [0..7] Instances&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; font-weight: normal; color: #7E22CE;&quot;&gt;8 Independent Glitch-Free Channel Slices&lt;/font&gt;&lt;hr style=&quot;margin: 6px 0; border: none; border-top: 1px solid #E9D5FF;&quot;&gt;&lt;div style=&quot;text-align: left; padding-left: 20px; font-size: 11.5px; font-weight: normal; color: #0F172A; line-height: 1.5;&quot;&gt;• &lt;b&gt;Shadow Duty Register&lt;/b&gt; — latches &lt;i&gt;duty_reg[i]&lt;/i&gt; synchronously on &lt;i&gt;period_tick&lt;/i&gt; or when &lt;i&gt;!ch_en[i]&lt;/i&gt;&lt;br&gt;• &lt;b&gt;8-Bit Magnitude Comparator&lt;/b&gt; — generates raw PWM pulse: &lt;i&gt;(count &amp;lt; duty_shadow[i])&lt;/i&gt;&lt;br&gt;• &lt;b&gt;Output Enable Gating&lt;/b&gt; — &lt;i&gt;pwm_out[i] = ch_en[i] &amp;amp; raw_pwm&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#9333EA;strokeWidth=2;align=center;verticalAlign=top;spacingTop=10;fontSize=14;fontColor=#581C87;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="200" y="435" width="600" height="125" as="geometry" />
        </mxCell>

