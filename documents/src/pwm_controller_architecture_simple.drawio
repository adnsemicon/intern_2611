        <!-- SUBMODULE 2: pwm_counter -->
        <mxCell id="mod_cnt" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;pwm_counter&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; font-weight: normal; color: #15803D;&quot;&gt;Shared 8-Bit Free-Running Timing Base&lt;/font&gt;&lt;hr style=&quot;margin: 6px 0; border: none; border-top: 1px solid #BBF7D0;&quot;&gt;&lt;div style=&quot;text-align: left; padding-left: 20px; font-size: 11.5px; font-weight: normal; color: #0F172A; line-height: 1.5;&quot;&gt;• &lt;b&gt;8-Bit Free-Running Up-Counter&lt;/b&gt; — continuous modulo-256 counter (0 to 255)&lt;br&gt;• &lt;b&gt;Period Tick Generator&lt;/b&gt; — 1-cycle strobe (&lt;i&gt;period_tick&lt;/i&gt;) at rollover (255)&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;strokeWidth=2;align=center;verticalAlign=top;spacingTop=10;fontSize=14;fontColor=#14532D;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="290" y="265" width="420" height="100" as="geometry" />
        </mxCell>

